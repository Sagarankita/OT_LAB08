+
+int
+setweight(int weight)
+{
+  struct proc *p = myproc();
+  if (weight < SCHED_MIN_WEIGHT || weight > SCHED_MAX_WEIGHT)
+    return -1;
+  acquire(&p->lock);
+  p->weight = weight;
+  p->stride = SCHED_STRIDE_BASE / weight;
+  release(&p->lock);
+  return 0;
+}
+
+int
+getschedstats(uint64 address)
+{
+  struct proc *p = myproc();
+  struct schedstats stats;
+  acquire(&p->lock);
+  stats.weight = p->weight;
+  stats.stride = p->stride;
+  stats.pass = p->pass;
+  stats.dispatches = p->dispatches;
+  stats.run_ticks = p->run_ticks;
+  release(&p->lock);
+  return copyout(p->pagetable, p->sz, address, (char *)&stats, sizeof(stats));
 }
 
+void
+schedtick(void)
+{
+  // A RUNNING process is owned by one CPU, so only that CPU updates this
+  // field. The value is diagnostic and has one timer-interrupt resolution.
+  struct proc *p = myproc();
+  if (p != 0)
+    p->run_ticks++;
+}
